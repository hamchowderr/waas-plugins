{
  "name": "otakusolutions/anypress-plugins-qa",
  "description": "Code checks for every AnyPress plugin: WordPress Coding Standards, PHP compatibility, PHPStan and dead code.",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1.8",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
    "phpstan/phpstan": "^2.3.5",
    "szepeviktor/phpstan-wordpress": "^2.0.4",
    "php-stubs/woocommerce-stubs": "^11.2",
    "shipmonk/dead-code-detector": "^1.4.2",
    "phpstan/extension-installer": "^1.4",
    "php-stubs/wordpress-stubs": "^7.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "autoload": {
    "classmap": [
      "WordPressUsageProvider.php"
    ]
  },
  "scripts": {
    "phpcs": "phpcs --standard=../../phpcs.xml.dist --basepath=../..",
    "phpcbf": "phpcbf --standard=../../phpcs.xml.dist --basepath=../..",
    "stan": "phpstan analyse -c ../../phpstan.neon.dist --memory-limit=2G"
  }
}
