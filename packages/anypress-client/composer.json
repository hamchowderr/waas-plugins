{
  "name": "otakusolutions/anypress-client",
  "description": "Runs on each AnyPress store: one-click login from the storefront and plan-based plugin roles.",
  "type": "project",
  "autoload": {
    "psr-4": {
      "AnyPressClient\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.1",
    "getbrevo/brevo-php": "^6.0",
    "mailerlite/mailerlite-php": "^1.1",
    "nyholm/psr7": "^1.8"
  },
  "authors": [
    {
      "name": "Otaku Solutions",
      "homepage": "https://otakusolutions.io"
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "brain/monkey": "^2.7"
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    },
    "platform": {
      "php": "8.3.0"
    }
  }
}
