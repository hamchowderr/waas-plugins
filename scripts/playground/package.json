{
  "name": "waas-plugins-playground",
  "private": true,
  "type": "module",
  "description": "Runs the WaaS plugins and AnyPress Export on WordPress Playground (WordPress in Node, no Docker) for end-to-end tests.",
  "engines": {
    "node": ">=24.18"
  },
  "scripts": {
    "smoke": "node smoke.mjs",
    "serve": "node smoke.mjs --serve",
    "export": "node export.mjs",
    "shop": "node shop-preview.mjs",
    "forms": "node forms.mjs",
    "shop-switch": "node shop-switch.mjs",
    "crm-switch": "node crm-switch.mjs",
    "emails": "node email-preview.mjs"
  },
  "dependencies": {
    "@wp-playground/cli": "3.1.59"
  }
}
