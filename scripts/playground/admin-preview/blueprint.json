{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/admin.php?page=waas-admin",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "login": true,
  "steps": [
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/hamchowderr/waas-plugins/main/scripts/playground/preview-zips/anypress.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "fluent-cart"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/hamchowderr/waas-plugins/697e626475d5975f6deb7bf86d83f3ada685a553/scripts/playground/preview-zips/fluent-toolkit.zip"
      },
      "options": {
        "activate": true,
        "targetFolderName": "fluent-toolkit"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/hamchowderr/waas-plugins/697e626475d5975f6deb7bf86d83f3ada685a553/scripts/playground/preview-zips/waas-host.zip"
      },
      "options": {
        "activate": true,
        "targetFolderName": "waas-host"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/waas-admin-preview.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/hamchowderr/waas-plugins/697e626475d5975f6deb7bf86d83f3ada685a553/scripts/playground/admin-preview/seed.php"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php\n// Loading WordPress once runs the seed (mu-plugin, on init), so the first page shows the sample websites.\nrequire '/wordpress/wp-load.php';\n// FluentKit's one dashboard for the Fluent plugins, as AnyPress storefronts have it.\nupdate_option('_fluent_kit_settings', array_merge((array) get_option('_fluent_kit_settings', []), ['uinified_ui' => 'yes', 'merge_admin_menus' => 'yes', 'hide_app_headers' => 'yes']));",
      "progress": {
        "caption": "Adding the sample websites"
      }
    }
  ],
  "meta": {
    "title": "WaaS Host: the AnyPress admin pages",
    "description": "A ready-made storefront selling websites: connected by AnyPress, its website plans made in FluentCart on first sign-in, sample customers and websites in every state, FluentKit's unified layout on.",
    "author": "hamchowderr"
  },
  "constants": {
    "WAAS_API_BASE_URL": "https://api.anypress.io",
    "WAAS_API_KEY": "ak_live_7f3c9a21",
    "WAAS_API_SECRET": "preview-secret"
  }
}
